# API key that callers must send in the `x-api-key` header
BOT_API_KEY=change-me-to-a-long-random-secret

# Port the Express server listens on
PORT=3000

# How long (ms) a paused browser session is kept alive while waiting for the
# user's OTP before it is auto-expired and cleaned up.
OTP_SESSION_TIMEOUT_MS=120000

# Optional: default webhook timeout / retry tuning
WEBHOOK_TIMEOUT_MS=10000
